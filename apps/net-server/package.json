{
  "name": "@apps/net-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/apps/net-server/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm run db:generate",
    "build": "tsc",
    "start": "node dist/apps/net-server/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "seed": "tsx src/scripts/seedMarketplace.ts",
    "migrate:marketplace": "tsx src/scripts/migrateMarketplaceToDB.ts",
    "migrate:users": "tsx src/scripts/migrateUsersToDB.ts",
    "create:admin": "tsx src/scripts/createAdmin.ts",
    "create:admin:profile": "tsx src/scripts/createAdminProfile.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-database.ts"
  },
  "dependencies": {
    "@engine/economy": "workspace:*",
    "@engine/world": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "fastify": "^5.0.0",
    "isomorphic-dompurify": "^2.30.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "ws": "^8.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "light-my-request": "^6.6.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}
