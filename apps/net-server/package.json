{
  "name": "@apps/net-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "seed": "tsx src/scripts/seedMarketplace.ts",
    "add-pvp-game": "tsx src/scripts/addPvpGame.ts",
    "check-pvp-game": "tsx src/scripts/checkPvpGame.ts",
    "debug-games-api": "tsx src/scripts/debugGamesApi.ts",
    "ensure-pvp-game": "tsx src/scripts/ensurePvpGame.ts",
    "assign-pvp-game": "tsx src/scripts/assignPvpGameToUser.ts",
    "regenerate-thumbnails": "tsx src/scripts/regenerateThumbnails.ts",
    "migrate:marketplace": "tsx src/scripts/migrateMarketplaceToDB.ts",
    "migrate:users": "tsx src/scripts/migrateUsersToDB.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:clear": "tsx src/scripts/clearDatabase.ts",
    "db:clear:all": "tsx src/scripts/clearDatabase.ts --clear-cache"
  },
  "dependencies": {
    "@engine/database": "workspace:*",
    "@engine/economy": "workspace:*",
    "@engine/world": "workspace:*",
    "@engine/wasm-physics": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@shared": "workspace:*",
    "@types/ioredis": "^5.0.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.34.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "pg": "^8.11.5",
    "ws": "^8.14.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "light-my-request": "^6.6.0",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}
