{
  "name": "ugc-3d-game-platform",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:all": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest watch --project unit --related",
    "test:ui": "vitest --project integration --ui",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest related --project unit",
    "test:fast": "vitest run --project unit --reporter=dot",
    "test:profile": "vitest run --project unit --reporter=verbose --runInBand",
    "precommit": "npm run lint && npm run test:unit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "@webgpu/types": "^0.1.65",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@preact/signals-core": "^1.12.1",
    "draco3dgltf": "^1.5.7",
    "gl-matrix": "^3.4.4"
  }
}
