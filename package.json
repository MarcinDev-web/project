{
  "name": "ugc-3d-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "shared"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @apps/editor dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "dev:editor": "pnpm --filter @apps/editor dev",
    "build:editor": "pnpm --filter @apps/editor build",
    "test:unit": "vitest run --project unit",
    "test:unit:fast": "vitest run --project unit --no-coverage --reporter=basic",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest watch --project unit --related",
    "test:changed": "vitest run --project unit --changed",
    "test:affected": "vitest run --project unit --coverage.enabled=false --bail=1",
    "test:ci": "vitest run --project unit --coverage.enabled=false --reporter=verbose",
    "precommit": "pnpm lint && pnpm test:changed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "@webgpu/types": "^0.1.65",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@preact/signals-core": "^1.12.1",
    "draco3dgltf": "^1.5.7",
    "gl-matrix": "^3.4.4",
    "pnpm": "^10.19.0"
  }
}
