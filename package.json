{
  "name": "play-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "services/*/*",
    "shared"
  ],
  "scripts": {
    "prebuild": "node ./scripts/verify-wasm-build.js",
    "postinstall": "node -e \"\"",
    "build": "pnpm --filter @engine/core run build && pnpm --filter @engine/microblocks run build && pnpm --filter @engine/blocks run build && pnpm --filter @engine/world run build && pnpm --filter @engine/script run build && pnpm --filter @engine/stdlib run build && pnpm --filter @engine/camera run build && pnpm --filter @engine/avatar run build && pnpm --filter \"@apps/net-server...\" --filter \"!@engine/test-utils\" --filter \"!@engine/gateway\" --filter \"!@engine/editor-utils\" --filter \"!@shared\" run build",
    "build:all": "pnpm -r build",
    "dev": "pnpm --filter @apps/editor dev",
    "test": "pnpm -r test",
    "lint": "pnpm --filter \"!@engine/test-utils\" -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "build:wasm": "pnpm build:collision-wasm && pnpm build:physics-wasm && pnpm build:animation-wasm && pnpm build:voxel-wasm && pnpm build:mesh-wasm && pnpm build:render-logic-wasm",
    "build:collision-wasm": "wasm-pack build crates/collision --target web --out-dir ../../packages/wasm-collision/pkg",
    "build:physics-wasm": "wasm-pack build crates/physics --target web --out-dir ../../packages/wasm-physics/pkg",
    "build:animation-wasm": "wasm-pack build crates/animation --target web --out-dir ../../packages/wasm-animation/pkg",
    "build:voxel-wasm": "wasm-pack build crates/voxel-engine --target web --out-dir ../../packages/wasm-voxel/pkg",
    "build:mesh-wasm": "wasm-pack build crates/mesh-processor --target web --out-dir ../../packages/wasm-mesh/pkg",
    "build:render-logic-wasm": "wasm-pack build crates/render-logic --target web --out-dir ../../packages/wasm-render-logic/pkg",
    "dev:editor": "pnpm --filter @apps/editor dev",
    "dev:platform": "pnpm --filter @apps/platform dev",
    "dev:server": "pnpm --filter @apps/net-server dev",
    "dev:game-server": "pnpm --filter @apps/game-server dev",
    "build:editor": "pnpm --filter @apps/editor build",
    "build:platform": "pnpm --filter @apps/platform build",
    "smoke:ws": "tsx scripts/smoke-ws.ts",
    "test:unit": "vitest run --project unit",
    "test:unit:fast": "vitest run --project unit --no-coverage --reporter=basic",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest watch --project unit --related",
    "test:changed": "vitest run --project unit --changed",
    "test:affected": "vitest run --project unit --coverage.enabled=false --bail=1",
    "test:ci": "vitest run --project unit --coverage.enabled=false --reporter=verbose",
    "test:coverage": "vitest run --coverage.enabled",
    "test:unit:coverage": "vitest run --project unit --coverage.enabled",
    "precommit": "pnpm verify:cost && pnpm --filter \"!@engine/test-utils\" -r lint && pnpm test:changed",
    "verify:cost": "tsx scripts/verify-cost-budgets.ts",
    "commitlint": "commitlint --edit",
    "commitlint:last": "commitlint --from HEAD~1 --to HEAD --verbose",
    "test:headless": "cd packages/world && pnpm test",
    "test:bench": "tsx packages/core/__benchmarks__/vec3.bench.ts && tsx packages/core/__benchmarks__/mat4.bench.ts && tsx packages/world/__benchmarks__/ecs.bench.ts",
    "measure:heap": "node --expose-gc --import tsx scripts/measure-heap.ts",
    "measure:heap:60s": "node --expose-gc --import tsx scripts/measure-heap.ts --duration=60 --entities=1000",
    "docker:push": "powershell -ExecutionPolicy Bypass -File scripts/docker-push.ps1",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/dev-orchestration.ps1",
    "verify:wasm": "node ./scripts/verify-wasm-build.js",
    "test:e2e": "playwright test",
    "test:perf": "vitest run packages/test-utils/__tests__/performance.example.test.ts",
    "test:visual": "playwright test packages/gfx-webgpu/tests/visual/",
    "test:webgpu": "playwright test packages/gfx-webgpu/tests/",
    "test:infra": "tsx scripts/test-infrastructure.ts",
    "test:infra:all": "tsx scripts/test-infrastructure.ts all --ci",
    "update:baselines": "tsx scripts/test-infrastructure.ts perf --update-baselines",
    "update:goldens": "tsx scripts/test-infrastructure.ts visual --update-goldens",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "prepare": "powershell -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@vercel/node": "^5.5.13",
    "@webgpu/types": "^0.1.65",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.14",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@engine/world": "workspace:*",
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@preact/signals-core": "^1.12.1",
    "draco3dgltf": "^1.5.7",
    "gl-matrix": "^3.4.4",
    "pnpm": "^10.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "prisma",
      "@prisma/engines",
      "@prisma/client",
      "msgpackr-extract",
      "wrtc",
      "esbuild"
    ]
  }
}
