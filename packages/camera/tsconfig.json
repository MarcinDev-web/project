{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "skipLibCheck": true,
    "paths": {
      "@engine/core": ["../core/dist"],
      "@engine/core/*": ["../core/dist/*"],
      "@engine/world": ["../world/dist"],
      "@engine/world/*": ["../world/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "dist", "node_modules"]
}

