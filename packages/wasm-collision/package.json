{
  "name": "@engine/wasm-collision",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "pkg",
    "src"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/collision --target web --out-dir ../../packages/wasm-collision/pkg",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "clean": "rimraf dist pkg",
    "lint": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
