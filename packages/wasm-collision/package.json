{
  "name": "@engine/wasm-collision",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/collision --target bundler --out-dir ./pkg",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "clean": "rimraf dist pkg"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}


