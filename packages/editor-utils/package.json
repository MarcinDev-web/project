{
    "name":  "@engine/editor-utils",
    "version":  "0.1.0",
    "description":  "Reusable utilities for building 3D editors and tools",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "development": "./src/index.ts",
            "test": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts":  {
                    "build":  "echo 'Skipping editor-utils build in production' || tsc",
                    "test":  "vitest",
                    "lint":  "eslint src --max-warnings=0"
                },
    "dependencies":  {
                         "@engine/core":  "workspace:*",
                         "@engine/world":  "workspace:*",
                         "@engine/script":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.0.9",
                            "typescript":  "^5.9.3",
                            "vitest":  "^4.0.17"
                        }
}
