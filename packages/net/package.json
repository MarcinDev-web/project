{
  "name": "@engine/net",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "development": "./src/index.ts",
      "test": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "echo 'Skipping net build in production' || tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@engine/core": "workspace:*",
    "@engine/net-protocol": "workspace:*",
    "@engine/world": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}

