{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["@webgpu/types", "node"],
    "paths": {
      "@engine/economy": ["../economy/dist"],
      "@engine/economy/*": ["../economy/dist/*"],
      "@engine/net-protocol": ["../net-protocol/dist"],
      "@engine/net-protocol/*": ["../net-protocol/dist/*"],
      "@engine/voxel": ["../voxel/dist"],
      "@engine/voxel/*": ["../voxel/dist/*"],
      "@engine/world-server": ["../world-server/dist"],
      "@engine/world-server/*": ["../world-server/dist/*"],
      "@engine/script": ["../script/dist"],
      "@engine/script/*": ["../script/dist/*"],
      "@engine/core": ["../core/src"],
      "@engine/core/*": ["../core/src/*"],
      "@engine/world": ["../world/src"],
      "@engine/world/*": ["../world/src/*"],
      "@engine/blocks": ["../blocks/src"],
      "@engine/blocks/*": ["../blocks/src/*"],
      "@engine/test-utils": ["../test-utils/dist"],
      "@engine/test-utils/*": ["../test-utils/dist/*"],
      "@engine/camera": ["../camera/dist"],
      "@engine/camera/*": ["../camera/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "__tests__",
    "dist",
    "node_modules",
    "../economy/src",
    "../net-protocol/src",
    "../voxel/src",
    "../world-server/src"
  ],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../world" }
  ]
}

