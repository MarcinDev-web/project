{
    "name":  "@engine/gfx-webgpu",
    "version":  "0.1.0",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  "./dist/index.js",
                    "./core":  "./dist/core/index.js",
                    "./config":  "./dist/config.js",
                    "./materials":  "./dist/materials/index.js",
                    "./textures":  "./dist/textures/index.js",
                    "./textures/*":  "./dist/textures/*.js",
                    "./blocks/BlockLibrary":  "./dist/blocks/BlockLibrary.js",
                    "./lighting/LightManager":  "./dist/lighting/LightManager.js",
                    "./shadows":  "./dist/shadows/index.js",
                    "./postprocess":  "./dist/postprocess/index.js"
                },
    "scripts":  {
                    "build":  "tsc",
                    "dev":  "tsc --watch",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "clean":  "rm -rf dist",
                    "lint":  "eslint src --max-warnings=0"
                },
    "dependencies":  {
                         "@engine/core":  "workspace:*",
                         "@engine/world":  "workspace:*",
                         "@engine/avatar":  "workspace:*",
                         "@engine/blocks":  "workspace:*",
                         "@engine/editor-utils":  "workspace:*",
                         "gl-matrix":  "^3.4.4"
                     },
    "devDependencies":  {
                            "@webgpu/types":  "^0.1.65",
                            "typescript":  "^5.9.3",
                            "vitest":  "^2.1.3"
                        }
}
