{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Use bundler module resolution (matching root tsconfig)
    // Note: .js extensions in imports are still required for Node.js ES modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@engine/core": ["../core/dist"],
      "@engine/core/*": ["../core/dist/*"],
      "@engine/world": ["../world/dist"],
      "@engine/world/*": ["../world/dist/*"],
      "@engine/stdlib": ["../stdlib/dist"],
      "@engine/stdlib/*": ["../stdlib/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "__tests__",
    "dist",
    "node_modules",
    "../core/src",
    "../world/src",
    "../stdlib/src"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../world" }
  ]
}

