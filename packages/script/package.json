{
    "name":  "@engine/script",
    "version":  "0.1.0",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                        "import": "./dist/index.js",
                        "development": "./src/index.ts",
                        "test": "./src/index.ts",
                        "default": "./dist/index.js"
                    },
                    "./LogicCubes":  {
                        "import": "./dist/LogicCubes/index.js",
                        "development": "./src/LogicCubes/index.ts",
                        "test": "./src/LogicCubes/index.ts",
                        "default": "./dist/LogicCubes/index.js"
                    },
                    "./runtime":  {
                        "import": "./dist/runtime/index.js",
                        "development": "./src/runtime/index.ts",
                        "test": "./src/runtime/index.ts",
                        "default": "./dist/runtime/index.js"
                    },
                    "./behavior":  {
                        "import": "./dist/behavior/index.js",
                        "development": "./src/behavior/index.ts",
                        "test": "./src/behavior/index.ts",
                        "default": "./dist/behavior/index.js"
                    },
                    "./Behavior":  {
                        "import": "./dist/behavior/Behavior.js",
                        "development": "./src/behavior/Behavior.ts",
                        "test": "./src/behavior/Behavior.ts",
                        "default": "./dist/behavior/Behavior.js"
                    }
                },
    "scripts":  {
                    "build":  "tsc -b",
                    "build:skip-lib-check":  "tsc -b --skipLibCheck",
                    "dev":  "tsc --watch",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "clean":  "rm -rf dist",
                    "lint":  "eslint src --max-warnings=0"
                },
    "dependencies":  {
                         "@engine/core":  "workspace:*",
                         "@engine/world":  "workspace:*",
                         "@engine/economy":  "workspace:*"
                     },
    "devDependencies":  {
                            "typescript":  "^5.9.3",
                            "vitest":  "^4.0.17"
                        }
}
