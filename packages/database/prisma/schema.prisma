// Unified Prisma schema for @engine/database
generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users
model User {
  id           String   @id
  email        String   @unique
  username     String?  @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  active       Boolean  @default(true)
  role         String   @default("user") // 'user' | 'moderator' | 'admin' | 'root'

  // Relations
  ownedProjects  Project[]
  memberProjects ProjectMember[]
  sessions       Session[]
  snapshots      SceneSnapshot[]

  @@index([username])
  @@map("users")
}

// Projects (Merged UserProject and Project)
model Project {
  id          String   @id
  ownerId     String   @map("owner_id")
  name        String
  description String?
  projectData Bytes?   @map("project_data")
  thumbnailUrl String? @map("thumbnail_url")
  isPublished Boolean  @default(false) @map("is_published")
  version     Int      @default(1)
  tags        String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Studio Team Access
  teamAccess  ProjectTeamAccess[]
  
  // Collab
  members     ProjectMember[]
  sessions    Session[]
  snapshots   SceneSnapshot[]

  @@index([ownerId])
  @@index([updatedAt(sort: Desc)])
  @@index([isPublished])
  @@index([tags], type: Gin)
  @@map("projects")
}

// ------------------- Collab Server Models -------------------

model ProjectMember {
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  role      String  @default("editor")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Session {
  id        String   @id
  projectId String   @map("project_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  snapshots SceneSnapshot[]

  @@map("sessions")
}

model SceneSnapshot {
  id        String   @id
  projectId String   @map("project_id")
  sessionId String?  @map("session_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  payload   Bytes

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("scene_snapshots")
}

// ------------------- Net Server Models -------------------

// Marketplace
model MarketplaceItem {
  id            String    @id
  type          String    // 'build' | 'avatar'
  title         String
  description   String?
  authorId      String    @map("author_id")
  authorName    String?   @map("author_name")
  thumbnailUrl  String?   @map("thumbnail_url")
  fileUrl       String    @map("file_url")
  tags          String[]  @default([])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  downloads     Int       @default(0)
  likes         Int       @default(0)
  isPublic      Boolean   @default(true) @map("public")
  priceCurrency String?   @map("price_currency")
  priceAmount   Decimal?  @map("price_amount") @db.Decimal
  forumThreadId String?   @map("forum_thread_id")

  build     MarketplaceBuild?
  avatar    MarketplaceAvatar?
  itemLikes MarketplaceLike[]

  @@index([type])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("marketplace_items")
}

model MarketplaceBuild {
  marketplaceId String   @id @map("marketplace_id")
  projectData   Bytes    @map("project_data")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  marketplaceItem MarketplaceItem @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@map("marketplace_builds")
}

model MarketplaceAvatar {
  marketplaceId String   @id @map("marketplace_id")
  avatarData    Bytes    @map("avatar_data") // AvatarLoadout serialized as JSON
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  marketplaceItem MarketplaceItem @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@map("marketplace_avatars")
}

// Studio Avatar Presets
model UserAvatarPreset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  avatarData  Bytes    @map("avatar_data") // AvatarLoadout serialized as JSON
  thumbnailUrl String? @map("thumbnail_url")
  tags        String[] @default([])
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isPublished])
  @@map("user_avatar_presets")
}

model MarketplaceLike {
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  item MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([itemId])
  @@index([userId])
  @@map("marketplace_likes")
}

model MarketplaceResaleListing {
  id            String    @id @default(uuid())
  marketplaceId String    @map("marketplace_id")
  sellerId      String    @map("seller_id")
  priceCurrency String    @map("price_currency")
  priceAmount   Decimal   @map("price_amount") @db.Decimal
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime? @map("expires_at")

  @@unique([marketplaceId, sellerId])
  @@index([marketplaceId])
  @@index([sellerId])
  @@index([expiresAt])
  @@map("marketplace_resale_listings")
}

model GameSession {
  gameId  String   @map("game_id")
  userId  String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([gameId, userId])
  @@map("game_sessions")
}

// Shop
model ShopItem {
  id           String   @id
  name         String
  description  String?
  category     String   // 'consumable' | 'cosmetic' | 'upgrade' | 'collectible'
  priceCurrency String   @map("price_currency")
  priceAmount  Decimal  @map("price_amount") @db.Decimal
  imageUrl     String?  @map("image_url")
  available    Boolean  @default(true)
  stock        Int?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([available])
  @@index([priceCurrency])
  @@map("shop_items")
}

model ShopAsset {
  id          String   @id
  name        String
  description String?
  type        String   // 'material' | 'model' | 'texture' | 'script'
  category    String?
  priceCurrency String   @map("price_currency")
  priceAmount  Decimal  @map("price_amount") @db.Decimal
  previewUrl  String?  @map("preview_url")
  fileUrl     String   @map("file_url")
  metadata    Json?
  authorId    String   @map("author_id")
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([type])
  @@index([category])
  @@index([available])
  @@index([authorId])
  @@map("shop_assets")
}

// Purchases
model Purchase {
  id           String   @id
  userId       String   @map("user_id")
  totalCurrency String   @map("total_currency")
  totalAmount   Decimal  @map("total_amount") @db.Decimal
  status       String   // 'pending' | 'completed' | 'failed'
  createdAt    DateTime @default(now()) @map("created_at")

  items PurchaseItem[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("purchases")
}

model PurchaseItem {
  purchaseId   String   @map("purchase_id")
  itemId       String   @map("item_id")
  itemType     String   @map("item_type") // 'shop-item' | 'asset' | 'marketplace-item'
  name         String
  priceCurrency String   @map("price_currency")
  priceAmount  Decimal  @map("price_amount") @db.Decimal

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@id([purchaseId, itemId, itemType])
  @@map("purchase_items")
}

model UserOwnedItem {
  userId     String   @map("user_id")
  itemId     String   @map("item_id")
  itemType   String   @map("item_type") // 'shop-item' | 'asset' | 'marketplace-item'
  purchasedAt DateTime @map("purchased_at")

  @@id([userId, itemId, itemType])
  @@index([userId])
  @@index([itemType])
  @@map("user_owned_items")
}

// Studio Teams
model StudioTeam {
  id          String   @id
  studioOwnerId String @unique @map("studio_owner_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  members     TeamMember[]
  invitations TeamInvitation[]
  projectAccess ProjectTeamAccess[]

  @@index([studioOwnerId])
  @@map("studio_teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   // 'owner' | 'member'
  joinedAt  DateTime @default(now()) @map("joined_at")
  invitedBy String   @map("invited_by")

  team StudioTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id            String   @id
  teamId        String   @map("team_id")
  inviterId     String   @map("inviter_id")
  inviteeUserId String?  @map("invitee_user_id")
  inviteeEmail  String?  @map("invitee_email")
  inviteeUsername String? @map("invitee_username")
  token         String   @unique
  status        String   @default("pending") // 'pending' | 'accepted' | 'declined' | 'expired'
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  team StudioTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteeUserId])
  @@index([token])
  @@index([status])
  @@map("team_invitations")
}

model ProjectTeamAccess {
  projectId  String @map("project_id")
  teamId     String @map("team_id")
  accessLevel String @map("access_level") // 'read' | 'write'
  userId     String? @map("user_id")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    StudioTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
  @@index([userId])
  @@map("project_team_access")
}

// Studio Settings
model StudioSetting {
  userId      String   @id @map("user_id")
  focus       String   @default("balanced") // 'games' | 'assets' | 'balanced'
  goals       Json     @default("{}")
  cadenceTarget Int     @default(2) @map("cadence_target")
  showRevenue Boolean  @default(true) @map("show_revenue")
  featureFlags Json    @default("{}") @map("feature_flags")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([focus])
  @@map("studio_settings")
}

model StudioMetricsDaily {
  userId      String   @map("user_id")
  date        DateTime @db.Date
  portfolioSize Int?    @map("portfolio_size")
  releases    Int?
  updates     Int?
  downloads   Int?
  ratingsCount Int?     @map("ratings_count")
  avgRating   Decimal? @map("avg_rating") @db.Decimal
  salesCount  Int?     @map("sales_count")
  grossRevenue Decimal? @map("gross_revenue") @db.Decimal
  netRevenue  Decimal? @map("net_revenue") @db.Decimal
  score       Decimal? @db.Decimal

  @@id([userId, date])
  @@index([date])
  @@map("studio_metrics_daily")
}

// Token blacklist
model TokenBlacklist {
  jti       String   @id
  expiresAt BigInt   @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("token_blacklist")
}

// Forum
model ForumCategory {
  id          String   @id
  name        String
  description String
  icon        String?
  color       String?
  order       Int      @default(999)
  isLocked    Boolean  @default(false) @map("is_locked")

  threads ForumThread[]

  @@index([order])
  @@map("forum_categories")
}

model ForumThread {
  id               String   @id
  categoryId       String   @map("category_id")
  authorId         String   @map("author_id")
  title            String
  content          String   // First post content
  isPinned         Boolean  @default(false) @map("is_pinned")
  isLocked         Boolean  @default(false) @map("is_locked")
  tags             String[] @default([])
  marketplaceItemId String?  @map("marketplace_item_id")
  projectToken     String?   @map("project_token")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts    ForumPost[]
  reactions ForumThreadReaction[]
  votes    ForumThreadVote[]

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([isPinned, createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("forum_threads")
}

model ForumPost {
  id        String   @id
  threadId  String   @map("thread_id")
  authorId  String   @map("author_id")
  content   String
  mentions  String[] @default([])
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reactions  ForumPostReaction[]
  votes      ForumPostVote[]

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("forum_posts")
}

model ForumThreadReaction {
  threadId  String   @map("thread_id")
  emoji     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, emoji, userId])
  @@index([threadId])
  @@index([userId])
  @@map("forum_thread_reactions")
}

model ForumPostReaction {
  postId    String   @map("post_id")
  emoji     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, emoji, userId])
  @@index([postId])
  @@index([userId])
  @@map("forum_post_reactions")
}

model ForumThreadVote {
  threadId  String   @map("thread_id")
  userId    String   @map("user_id")
  vote      String   // 'up' | 'down'
  createdAt DateTime @default(now()) @map("created_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([threadId])
  @@index([userId])
  @@map("forum_thread_votes")
}

model ForumPostVote {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  vote      String   // 'up' | 'down'
  createdAt DateTime @default(now()) @map("created_at")

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("forum_post_votes")
}

// Support System
model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   // 'bug' | 'question' | 'feature' | 'other'
  status      String   @default("open") // 'open' | 'in_progress' | 'resolved' | 'closed'
  priority    String   @default("medium") // 'low' | 'medium' | 'high' | 'urgent'
  title       String
  description String
  metadata    Json?    // Additional data (browser info, screenshots, etc.)
  assignedTo  String?  @map("assigned_to") // User ID of moderator/admin
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String
  isInternal Boolean  @default(false) @map("is_internal") // For staff notes
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("support_ticket_messages")
}

model SupportFAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String   // 'general' | 'editor' | 'marketplace' | 'account' | 'technical'
  order       Int      @default(999)
  isPublished Boolean  @default(false) @map("is_published")
  tags        String[] @default([])
  viewCount   Int      @default(0) @map("view_count")
  helpfulCount Int     @default(0) @map("helpful_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublished])
  @@index([order])
  @@index([tags], type: Gin)
  @@map("support_faqs")
}

