{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@engine/economy": ["../economy/src"],
      "@engine/economy/*": ["../economy/src/*"],
      "@engine/net-protocol": ["../net-protocol/src"],
      "@engine/net-protocol/*": ["../net-protocol/src/*"],
      "@engine/voxel": ["../voxel/src"],
      "@engine/voxel/*": ["../voxel/src/*"],
      "@engine/world": ["../world/src"],
      "@engine/world/*": ["../world/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "dist", "node_modules"],
  "references": [
    { "path": "../core" },
    { "path": "../world" },
    { "path": "../net-protocol" },
    { "path": "../voxel" },
    { "path": "../economy" }
  ]
}