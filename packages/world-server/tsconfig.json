{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@engine/animation": ["../animation/dist"],
      "@engine/animation/*": ["../animation/dist/*"],
      "@engine/economy": ["../economy/dist"],
      "@engine/economy/*": ["../economy/dist/*"],
      "@engine/net-protocol": ["../net-protocol/dist"],
      "@engine/net-protocol/*": ["../net-protocol/dist/*"],
      "@engine/voxel": ["../voxel/dist"],
      "@engine/voxel/*": ["../voxel/dist/*"],
      "@engine/world": ["../world/dist"],
      "@engine/world/*": ["../world/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "dist", "node_modules"],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../world/tsconfig.build.json" },
    { "path": "../net-protocol" },
    { "path": "../voxel" },
    { "path": "../economy" }
  ]
}