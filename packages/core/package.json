{
  "name": "@engine/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js",
      "default": "./dist/math/index.js"
    },
    "./ecs": {
      "types": "./dist/ecs/index.d.ts",
      "import": "./dist/ecs/index.js",
      "default": "./dist/ecs/index.js"
    },
    "./event": {
      "types": "./dist/event/index.d.ts",
      "import": "./dist/event/index.js",
      "default": "./dist/event/index.js"
    },
    "./event/EventBus": {
      "types": "./dist/event/EventBus.d.ts",
      "import": "./dist/event/EventBus.js",
      "default": "./dist/event/EventBus.js"
    },
    "./job": {
      "types": "./dist/job/index.d.ts",
      "import": "./dist/job/index.js",
      "default": "./dist/job/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./script": {
      "types": "./dist/script/index.d.ts",
      "import": "./dist/script/index.js",
      "default": "./dist/script/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.3",
    "jsdom": "^27.0.0"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  }
}
