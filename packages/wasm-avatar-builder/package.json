{
  "name": "@engine/wasm-avatar-builder",
  "version": "0.1.0",
  "description": "High-performance avatar mesh generation and skeleton system in Rust/WASM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "cd ../../crates/avatar-builder && wasm-pack build --target web --out-dir ../../packages/wasm-avatar-builder/pkg --release",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "clean": "rimraf dist pkg target"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "directory": "packages/wasm-avatar-builder"
  },
  "license": "MIT"
}

