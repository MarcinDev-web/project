{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@engine/core": ["../core/dist"],
      "@engine/core/*": ["../core/dist/*"],
      "@engine/animation": ["../animation/dist/src"],
      "@engine/animation/*": ["../animation/dist/src/*"],
      "@engine/economy": ["../economy/dist/src"],
      "@engine/economy/*": ["../economy/dist/src/*"],
      "@engine/world-server": ["../world-server/dist"],
      "@engine/world-server/*": ["../world-server/dist/*"],
      "@engine/script": ["../script/dist"],
      "@engine/script/*": ["../script/dist/*"],
      "@engine/stdlib": ["../stdlib/dist"],
      "@engine/stdlib/*": ["../stdlib/dist/*"],
      "@engine/voxel": ["../voxel/dist"],
      "@engine/voxel/*": ["../voxel/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../animation/tsconfig.json" },
    { "path": "../blocks" },
    { "path": "../economy" }
    // Note: script is excluded here to handle circular dependency
    // Script is built separately before world, then world is rebuilt with script reference
  ]
}

