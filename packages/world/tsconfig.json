{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    // Use bundler module resolution (matching root tsconfig)
    // Note: .js extensions in imports are still required for Node.js ES modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@engine/core": ["../core/dist"],
      "@engine/core/*": ["../core/dist/*"],
      "@engine/animation": ["../animation/dist"],
      "@engine/animation/*": ["../animation/dist/*"],
      "@engine/economy": ["../economy/dist/src"],
      "@engine/economy/*": ["../economy/dist/src/*"],
      "@engine/world-server": ["../world-server/dist"],
      "@engine/world-server/*": ["../world-server/dist/*"],
      "@engine/script": ["../script/dist"],
      "@engine/script/*": ["../script/dist/*"],
      "@engine/stdlib": ["../stdlib/dist"],
      "@engine/stdlib/*": ["../stdlib/dist/*"],
      "@engine/voxel": ["../voxel/dist"],
      "@engine/voxel/*": ["../voxel/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "__tests__",
    "dist",
    "node_modules",
    "../economy/src",
    "../world-server/src",
    "../script/src",
    "../stdlib/src",
    "../voxel/src"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../animation" },
    { "path": "../blocks" }
  ]
}

