{
    "name":  "@engine/world",
    "version":  "0.1.0",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                        "import": "./dist/index.js",
                        "development": "./src/index.ts",
                        "test": "./src/index.ts",
                        "default": "./dist/index.js"
                    },
                    "./core":  {
                        "import": "./dist/core/index.js",
                        "development": "./src/core/index.ts",
                        "test": "./src/core/index.ts",
                        "default": "./dist/core/index.js"
                    },
                    "./components":  {
                        "import": "./dist/components/index.js",
                        "development": "./src/components/index.ts",
                        "test": "./src/components/index.ts",
                        "default": "./dist/components/index.js"
                    },
                    "./components/*":  {
                        "import": "./dist/components/*.js",
                        "development": "./src/components/*.ts",
                        "test": "./src/components/*.ts",
                        "default": "./dist/components/*.js"
                    },
                    "./systems":  {
                        "import": "./dist/systems/index.js",
                        "development": "./src/systems/index.ts",
                        "test": "./src/systems/index.ts",
                        "default": "./dist/systems/index.js"
                    },
                    "./physics":  {
                        "import": "./dist/physics/index.js",
                        "development": "./src/physics/index.ts",
                        "test": "./src/physics/index.ts",
                        "default": "./dist/physics/index.js"
                    },
                    "./utils":  {
                        "import": "./dist/utils/index.js",
                        "development": "./src/utils/index.ts",
                        "test": "./src/utils/index.ts",
                        "default": "./dist/utils/index.js"
                    },
                    "./data/*":  {
                        "import": "./dist/data/*.js",
                        "development": "./src/data/*.ts",
                        "test": "./src/data/*.ts",
                        "default": "./dist/data/*.js"
                    },
                    "./types/*":  {
                        "import": "./dist/types/*.js",
                        "development": "./src/types/*.ts",
                        "test": "./src/types/*.ts",
                        "default": "./dist/types/*.js"
                    },
                    "./net/InputChannel":  {
                        "import": "./dist/net/InputChannel.js",
                        "development": "./src/net/InputChannel.ts",
                        "test": "./src/net/InputChannel.ts",
                        "default": "./dist/net/InputChannel.js"
                    },
                    "./sim/AuthoritativeWorld":  {
                        "import": "./dist/sim/AuthoritativeWorld.js",
                        "development": "./src/sim/AuthoritativeWorld.ts",
                        "test": "./src/sim/AuthoritativeWorld.ts",
                        "default": "./dist/sim/AuthoritativeWorld.js"
                    }
                },
    "scripts":  {
                    "build":  "tsc -b tsconfig.build.json",
                    "build:verify":  "tsc -b tsconfig.build.json && node ../../scripts/verify-world-build.js",
                    "dev":  "tsc --watch",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "clean":  "rimraf dist",
                    "lint":  "eslint src --max-warnings=0"
                },
    "dependencies":  {
                         "@engine/core":  "workspace:*",
                         "@engine/animation":  "workspace:*",
                         "@engine/wasm-animation": "workspace:*",
                         "@engine/blocks":  "workspace:*",
                         "@engine/economy":  "workspace:*",
                         "@engine/microblocks":  "workspace:*",
                         "@engine/script":  "workspace:*",
                         "@engine/wasm-collision": "workspace:*",
                         "@engine/wasm-physics": "workspace:*",
                         "@engine/wasm-voxel": "workspace:*",
                         "gl-matrix":  "^3.4.4"
                     },
    "devDependencies":  {
                            "@engine/test-utils":  "workspace:*",
                            "typescript":  "^5.9.3",
                            "vitest":  "^4.0.14"
                        }
}
