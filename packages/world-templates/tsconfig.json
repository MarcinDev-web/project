{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@engine/world-server": ["../world-server/dist"],
      "@engine/world-server/*": ["../world-server/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "dist", "node_modules", "../world-server/src"],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../world" }
  ]
}


