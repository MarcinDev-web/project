{
  "name": "@engine/voxel",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "test": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./terrain": {
      "import": "./dist/terrain/index.js",
      "development": "./src/terrain/index.ts",
      "test": "./src/terrain/index.ts",
      "default": "./dist/terrain/index.js"
    }
  },
  "scripts": {
    "build": "echo 'Skipping voxel build in production' || tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@engine/core": "workspace:*",
    "@engine/world": "workspace:*",
    "@engine/wasm-mesh": "workspace:*"
  },
  "devDependencies": {
    "@engine/test-utils": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}

