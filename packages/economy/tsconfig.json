{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@engine/world": ["../world/dist"],
      "@engine/world/*": ["../world/dist/*"],
      "@engine/animation": ["../animation/dist"],
      "@engine/animation/*": ["../animation/dist/*"],
      "@engine/world-server": ["../world-server/src", "../world-server/dist"],
      "@engine/world-server/*": ["../world-server/src/*", "../world-server/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "__tests__",
    "dist",
    "node_modules",
    "../world-server/src",
    "../world/src",
    "../animation/src"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../animation" }
  ]
}

