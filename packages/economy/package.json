{
  "name": "@engine/economy",
  "version": "0.1.0",
  "description": "Currency and economy system for game players and marketplace transactions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "test": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "import": "./dist/examples/CurrencySystemExample.js",
      "development": "./src/examples/CurrencySystemExample.ts",
      "test": "./src/examples/CurrencySystemExample.ts",
      "default": "./dist/examples/CurrencySystemExample.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@engine/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}

