node_modules

# Build artifacts
dist/
*.tsbuildinfo

# Ignore compiled TypeScript files in src/ directories
# These should only exist in dist/ after build
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.js.map
**/src/**/*.d.ts.map
# But keep source .ts files
!**/src/**/*.ts

# Rust/Cargo
target/
**/target/
Cargo.lock
**/Cargo.lock

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
*.lcov
.nyc_output/

# Environment
.env
.env.local
.env.*.local

# Backup files
*.backup
*.bak
*.tmp
.vercel
