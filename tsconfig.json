{
  "compilerOptions": {
    // Environment Settings
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "node"],
    
    // Module Resolution
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    // Output Options
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    // Strict Checks
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    
    // Other Options
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    
    // Path Aliases for Monorepo
    "paths": {
      "@engine/core": ["./packages/core/src"],
      "@engine/core/*": ["./packages/core/src/*"],
      "@engine/animation": ["./packages/animation/src"],
      "@engine/animation/*": ["./packages/animation/src/*"],
      "@engine/avatar": ["./packages/avatar/src"],
      "@engine/avatar/*": ["./packages/avatar/src/*"],
      "@engine/world": ["./packages/world/src"],
      "@engine/world/*": ["./packages/world/src/*"],
      "@engine/world-templates": ["./packages/world-templates/src"],
      "@engine/world-templates/*": ["./packages/world-templates/src/*"],
      "@engine/gfx-webgpu": ["./packages/gfx-webgpu/src"],
      "@engine/gfx-webgpu/*": ["./packages/gfx-webgpu/src/*"],
      "@engine/script": ["./packages/script/src"],
      "@engine/script/*": ["./packages/script/src/*"],
      "@engine/input": ["./packages/input/src"],
      "@engine/input/*": ["./packages/input/src/*"],
      "@engine/camera": ["./packages/camera/src"],
      "@engine/camera/*": ["./packages/camera/src/*"],
      "@engine/stdlib": ["./packages/stdlib/src"],
      "@engine/stdlib/*": ["./packages/stdlib/src/*"],
      "@engine/editor-utils": ["./packages/editor-utils/src"],
      "@engine/editor-utils/*": ["./packages/editor-utils/src/*"],
      "@engine/blocks": ["./packages/blocks/src"],
      "@engine/blocks/*": ["./packages/blocks/src/*"],
      "@engine/economy": ["./packages/economy/src"],
      "@engine/economy/*": ["./packages/economy/src/*"],
      "@engine/test-utils": ["./packages/test-utils/src"],
      "@engine/test-utils/*": ["./packages/test-utils/src/*"],
      "@engine/wasm-collision": ["./packages/wasm-collision/src"],
      "@engine/wasm-collision/*": ["./packages/wasm-collision/src/*"],
      "@engine/microblocks": ["./packages/microblocks/src"],
      "@engine/microblocks/*": ["./packages/microblocks/src/*"],
      "@engine/voxel": ["./packages/voxel/src"],
      "@engine/voxel/*": ["./packages/voxel/src/*"],
      "@engine/net": ["./packages/net/src"],
      "@engine/net/*": ["./packages/net/src/*"],
      "@engine/net-protocol": ["./packages/net-protocol/src"],
      "@engine/net-protocol/*": ["./packages/net-protocol/src/*"],
      "@engine/net-server": ["./packages/net-server/src"],
      "@engine/net-server/*": ["./packages/net-server/src/*"],
      "@engine/world-server": ["./packages/world-server/src"],
      "@engine/world-server/*": ["./packages/world-server/src/*"],
      "@engine/gateway": ["./packages/gateway/src"],
      "@engine/gateway/*": ["./packages/gateway/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "**/__tests__"
  ]
}
