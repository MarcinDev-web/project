{
  "version": 2,
  "buildCommand": "pnpm build:platform",
  "outputDirectory": "apps/platform/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/((?!assets|api|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

