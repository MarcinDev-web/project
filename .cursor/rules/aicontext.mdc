## 🎨 Code Style & Conventions

### TypeScript Rules

```typescript
// ✅ Strict mode ALWAYS enabled
// ✅ Prefer type inference for locals, explicit for public APIs
export function createEntity(name: string): Entity { // Explicit return
  const id = generateId(); // Inferred
  return new Entity(id, name);
}

// ✅ Use unknown over any when type is truly unknown
function parse(data: unknown): Result {
  if (typeof data === 'string') { /* ... */ }
}

// ❌ NO any without comment explaining why
function legacy(data: any) { // BAD
  return data.something;
}

// ✅ any with justification
function legacy(data: any /* legacy API, no types available */) {
  return data.something;
}
```

### Functional Patterns

```typescript
// ✅ Prefer functional components and composition
export function createSystem(scene: Scene) {
  const entities: Entity[] = [];
  
  return {
    update: (dt: number) => { /* ... */ },
    dispose: () => entities.forEach(e => e.dispose()),
  };
}

// ✅ Keep functions small (<50 lines ideally)
// ✅ Use async/await over raw Promises
async function loadAsset(url: string): Promise<Asset> {
  const response = await fetch(url);
  return await response.json();
}

// ✅ Destructure for readability
function render({ camera, scene, viewport }: RenderContext) {
  // clearer than render(context)
}
```

### Performance Mindset

```typescript
// ✅ Question every allocation in hot paths (render loops, physics updates)
class System {
  private tempVec = new Vec3(); // Reuse, don't allocate per frame
  
  update(entities: Entity[]) {
    for (const entity of entities) {
      this.tempVec.set(entity.x, entity.y, entity.z); // Reuse
      // NOT: const temp = new Vec3(entity.x, entity.y, entity.z); ❌
    }
  }
}

// ✅ Consider cache locality for data structures
// Store transform components contiguously for better iteration

// ✅ Batch operations where possible
renderer.batch(() => {
  for (const mesh of meshes) {
    renderer.drawMesh(mesh);
  }
});

// ✅ Lazy load non-critical resources
class AssetManager {
  private cache = new Map<string, Promise<Asset>>();
  
  async load(url: string): Promise<Asset> {
    if (!this.cache.has(url)) {
      this.cache.set(url, this.fetchAsset(url));
    }
    return this.cache.get(url)!;
  }
}
```

