## 🧪 Testing Philosophy

### Test Behavior, Not Implementation

```typescript
// ✅ GOOD - Tests observable behavior
test('entity position updates correctly', () => {
  const entity = new Entity();
  entity.setPosition(1, 2, 3);
  expect(entity.getPosition()).toEqual([1, 2, 3]);
});

// ❌ BAD - Tests internal implementation
test('entity stores position in _position field', () => {
  const entity = new Entity();
  entity._position = [1, 2, 3]; // Testing private details
  expect(entity._position).toBeDefined();
});
```

### Mock External Dependencies

```typescript
// ✅ Mock WebGPU, file system, network
vi.mock('@engine/gfx-webgpu', () => ({
  Renderer: vi.fn().mockImplementation(() => ({
    render: vi.fn(),
    dispose: vi.fn(),
  })),
}));

// ✅ Use @engine/test-utils for common mocks
import { createMockCanvas, entityFixtures } from '@engine/test-utils';

test('renderer initializes with canvas', () => {
  const canvas = createMockCanvas(800, 600);
  const renderer = new Renderer(canvas);
  expect(renderer.isReady()).toBe(true);
});
```

### Test Organization

```typescript
// ✅ Use concurrent for independent tests (faster)
describe.concurrent('Math utilities', () => {
  test('vec3 addition', () => { /* ... */ });
  test('vec3 subtraction', () => { /* ... */ });
});

// ✅ Always cleanup in afterEach
describe('System lifecycle', () => {
  let system: System;
  
  beforeEach(() => {
    system = new System();
  });
  
  afterEach(() => {
    system.dispose(); // CRITICAL: prevent leaks
    vi.clearAllMocks();
    vi.clearAllTimers();
  });
  
  test('updates correctly', () => { /* ... */ });
});
```

