## 🚀 Common Tasks & Patterns

### Creating a New Package

```bash
# 1. Create directory structure
mkdir -p packages/my-package/src
cd packages/my-package

# 2. Create package.json
{
  "name": "@engine/my-package",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}

# 3. Create tsconfig.json (extend from root)
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  }
}

# 4. Export from src/index.ts
export * from './MyModule';
```

### Adding a New Component

```typescript
// packages/world/src/components/MyComponent.ts
import { Component } from './Component';

export interface MyComponentData {
  property: number;
}

export class MyComponent extends Component {
  public property: number;
  
  constructor(data: MyComponentData) {
    super('MyComponent');
    this.property = data.property;
  }
  
  serialize(): MyComponentData {
    return { property: this.property };
  }
  
  dispose(): void {
    // Cleanup resources
  }
}

// Don't forget to export from packages/world/src/index.ts
export { MyComponent } from './components/MyComponent';
```

### Writing Tests

```typescript
// packages/world/__tests__/MyComponent.test.ts
import { describe, test, expect, beforeEach, afterEach } from 'vitest';
import { MyComponent } from '../src/components/MyComponent';

describe('MyComponent', () => {
  let component: MyComponent;
  
  beforeEach(() => {
    component = new MyComponent({ property: 42 });
  });
  
  afterEach(() => {
    component.dispose();
  });
  
  test('initializes with correct value', () => {
    expect(component.property).toBe(42);
  });
  
  test('serializes correctly', () => {
    const data = component.serialize();
    expect(data).toEqual({ property: 42 });
  });
});
```

